{
  "$schema": "https://opencode.ai/config.json",
  // Process skills (brainstorming, systematic-debugging, writing-plans, ...)
  // come from the superpowers plugin. OpenMontage's domain skills are
  // discovered from .agents/skills; no extra skill registration is needed.
  // Provider/model credentials stay machine-local in ~/.config/opencode or
  // environment variables and must never be committed here.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
